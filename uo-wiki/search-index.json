---
layout: null
permalink: /search-index.json
---
[
{%- assign entries = site.pages | where_exp: 'item', 'item.title != nil' | where_exp: 'item', 'item.url != "/404.html"' | where_exp: 'item', 'item.layout == "default" or item.layout == "home"' -%}
{%- for entry in entries -%}
{"title":{{ entry.title | jsonify }},"category":{{ entry.parent | default: 'Systems' | jsonify }},"url":{{ entry.url | relative_url | jsonify }},"text":{{ entry.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
